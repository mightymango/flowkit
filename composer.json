{
    "name": "mightymango/flowkit",
    "description": "A Zapier-style workflow builder for Laravel Livewire apps: a headless engine, a step-list editor and publishable Blade components.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "livewire", "workflow", "automation"],
    "authors": [
        {
            "name": "Simon Barrett",
            "email": "simonbarrett@hey.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "laravel/prompts": "^0.1.18|^0.2|^0.3",
        "livewire/livewire": "^3.5|^4.0",
        "symfony/expression-language": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MightyMango\\Flowkit\\": "src/",
            "MightyMango\\Flowkit\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MightyMango\\Flowkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MightyMango\\Flowkit\\FlowkitServiceProvider"
            ],
            "aliases": {
                "Flowkit": "MightyMango\\Flowkit\\Facades\\Flowkit"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
